# Synveil scheduled maintenance — non-secret configuration template
# This file is loaded via EnvironmentFile=-/etc/synveil/synveil-scheduled-maintenance.env
# for non-secret runtime tuning only. Database credentials are NOT stored here
# in production (Prompt 77). They are delivered via systemd credentials:
#
#   Administrator creates:
#     /etc/synveil/credentials/database-url  (root:root 0600, /etc/synveil/credentials root:root 0700)
#   Service loads via:
#     LoadCredential=database-url:/etc/synveil/credentials/database-url
#     Environment=SYNVEIL_DATABASE_CREDENTIAL_FILE=%d/database-url
#   One-shot reads the file once via database_config_from_runtime().
#
# No DATABASE_URL, password, token, or private key belongs in this file for
# production. For development/manual invocation without systemd, DATABASE_URL
# env remains supported as a fallback (use: DATABASE_URL=postgresql://... /usr/bin/synveil-scheduled-maintenance-once).
#
# Copy to /etc/synveil/synveil-scheduled-maintenance.env and set restrictive permissions:
#   sudo install -d -m 0750 -o root -g synveil /etc/synveil
#   sudo install -m 0640 -o root -g synveil synveil-scheduled-maintenance.env.example /etc/synveil/synveil-scheduled-maintenance.env
# Then edit non-secret settings below if needed.
#
# Optional: lease duration in seconds, 10..=900, default 120
# SYNVEIL_SCHEDULED_MAINTENANCE_LEASE_SECONDS=120
#
# See docs/en/BACKUP.md and docs/en/DEPLOYMENT.md for credential architecture,
# rotation (atomic rename), and error semantics.
# Prompt 77 owns secret delivery; this template is controlled and contains no functional credential.
