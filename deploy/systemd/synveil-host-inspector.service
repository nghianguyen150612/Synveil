[Unit]
Description=Synveil read-only Host inspection
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/libexec/synveil-host-helper inspect-service
User=root
Group=root
RuntimeDirectory=synveil-host
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5s
UMask=0077
ProtectSystem=strict
ReadWritePaths=/run/synveil-host
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_SYS_PTRACE CAP_KILL
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
