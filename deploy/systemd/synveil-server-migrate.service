[Unit]
Description=Synveil canonical server migration gate
After=synveil-postgresql.service
Before=synveil-api.service synveil-worker.service

[Service]
Type=oneshot
User=synveil
Group=synveil
ExecStart=/opt/synveil/server/current/synveil-server-migrate
Environment=SYNVEIL_SERVER_CONFIG_FILE=/etc/synveil/server-config.json
Environment=SYNVEIL_DATABASE_CREDENTIAL_FILE=%d/database-url
LoadCredential=database-url:/etc/synveil/credentials/database-url
TimeoutStartSec=90
UMask=0077
NoNewPrivileges=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/etc/synveil/credentials
StandardOutput=journal
StandardError=journal
