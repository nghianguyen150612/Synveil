[Unit]
Description=Synveil managed HTTPS edge
PartOf=synveil-server.target
Requires=synveil-api.service
After=synveil-api.service

[Service]
Type=notify
User=synveil-edge
Group=synveil-edge
ExecStart=/opt/synveil/edge/current/caddy run --config /etc/synveil/network/Caddyfile --adapter caddyfile
ExecReload=/opt/synveil/edge/current/caddy reload --config /etc/synveil/network/Caddyfile --adapter caddyfile
LoadCredential=network-tls-key:/etc/synveil/credentials/network-tls-key
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=/etc/synveil/credentials
ReadOnlyPaths=/etc/synveil/network
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=synveil-server.target
